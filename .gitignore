# ============================================================
# Mahalaxmi POS - Root .gitignore
# ============================================================

# ---- Environment / Secrets ----
.env
.env.local
.env.*.local
*.env

# ---- Backend (Java / Maven / Spring Boot) ----
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/.flattened-pom.xml
backend/*.log
backend/logs/

# ---- Frontend (Node / Vite / React) ----
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/*.log

# ---- IDEs & Editors ----
.idea/
*.iml
.vscode/
*.swp
*.swo
.project
.classpath
.settings/

# ---- OS Files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs ----
*.log
logs/

# ---- Build artifacts ----
*.class
*.jar
*.war
*.ear

# ---- Test reports ----
backend/target/surefire-reports/
backend/target/site/

# ---- Docker ----
docker-compose.override.yml

# Mahalaxmi POS Backend - Environment Variables
# Copy this file, fill in values, and DO NOT commit the filled version

# Database Configuration (supports both standard Spring Boot and custom aliases)
# For local development:
DB_URL=jdbc:postgresql://localhost:5432/mahalaxmi_pos
DB_USERNAME=postgres
DB_PASSWORD=postgres

# For Aiven / Production:
# SPRING_DATASOURCE_URL=jdbc:postgresql://<aiven-host>:<port>/<dbname>?sslmode=require
# SPRING_DATASOURCE_USERNAME=avnadmin
# SPRING_DATASOURCE_PASSWORD=<your_aiven_password>
# OR use DB_URL, DB_USERNAME, DB_PASSWORD:
# DB_URL=jdbc:postgresql://<aiven-host>:<port>/<dbname>?sslmode=require
# DB_USERNAME=avnadmin
# DB_PASSWORD=<your_aiven_password>

# Server Port (Render automatically sets PORT)
PORT=8080

# Active Spring Profile (e.g. prod for production)
# SPRING_PROFILES_ACTIVE=prod

# JWT Authentication
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=your_very_long_and_secure_jwt_secret_here
JWT_EXPIRATION_MS=86400000

# CORS (Frontend origin)
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Development seeding (DEV ONLY: creates initial admin user if true, disabled in prod profile)
DEV_SEED=false
DEV_ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
